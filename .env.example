# Copy this file to .env.local and fill in the values from
# Supabase → "Connect" button (top bar) or Project Settings → API Keys.
# Paste the publishable key (sb_publishable_...) into the ANON_KEY variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
